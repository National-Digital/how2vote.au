<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Backups are disabled entirely: WebView localStorage holds the user's quiz answers
         (political opinions) and the product guarantee is that answers never leave the device —
         silent Auto-Backup to a cloud account would break that. The exclusion rules are belt and
         braces for the D2D/cloud paths on Android 12+. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: claim https://how2vote.au/* so a shared card opens in-app. autoVerify
                 checks /.well-known/assetlinks.json on the domain (emitted by the web build once
                 ANDROID_CERT_SHA256 is set); until verified Android just opens the link in the
                 browser, so this is safe to ship before the cert fingerprint exists. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="how2vote.au" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- The only permission this manifest declares, and used only on an explicit user action: the
         contact form and the opt-in research contribution POST to first-party endpoints, and
         outbound links open in the in-app browser. Capacitor also requires it for the
         https://localhost WebView origin the bundle is served from. Nothing is fetched at startup;
         dataset, maps, stats and fonts ship in the binary. The merged APK also carries an app-local
         signature permission androidx.core injects — see docs/store-distribution.md, "Declared
         permissions", which the fdroid CI job asserts against the built APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The activity's portrait lock (phones) implicitly marks android.hardware.screen.portrait
         as REQUIRED, which would filter landscape-only devices (some tablets, Chromebooks) out of
         the Play device catalog. The layout is responsive and large screens under targetSdk 36
         rotate regardless, so declare the feature optional to keep those devices eligible. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
</manifest>
