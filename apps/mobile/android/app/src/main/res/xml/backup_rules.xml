<?xml version="1.0" encoding="utf-8" ?>
<!-- Pre-Android-12 full-backup path: exclude everything. WebView localStorage holds the user's
     quiz answers (political opinions); the product guarantee is on-device only. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
