# Formspree (https://formspree.io) form IDs. Both the per-page Feedback widget and the Contact page
# post to Formspree's AJAX endpoint (https://formspree.io/f/<id>). These are separate vars — even
# though they point at the same Formspree form today — so feedback and contact can be routed to
# different forms later without a code change. Form IDs are not secret (they ship in the client), so
# in CI these are supplied as GitHub Actions *variables* of the same name (see deploy.yml), not
# secrets. Being PUBLIC_-prefixed, SvelteKit exposes them to the browser bundle at build time.
# Placeholders only — set your own form IDs locally / in CI.
PUBLIC_FEEDBACK_FORM_ID=your-formspree-form-id
PUBLIC_CONTACT_FORM_ID=your-formspree-form-id

# Cloudflare Turnstile site keys. Two SEPARATE widgets keep the anonymous research/survey challenge
# isolated from the identifiable contact/feedback forms — distinct site keys AND distinct secrets, so
# neither config nor per-widget analytics is ever shared between the two paths.
#
# FORMS widget: both forms run the cookieless, non-interactive Turnstile challenge on submit and send
# its token to Formspree, which verifies it with the matching *secret* key configured on the Formspree
# form (that secret lives only on Formspree — never in this repo).
#
# RESEARCH widget: the survey runs its own challenge on submit and sends the solution to
# /api/research/token as `challenge`; the Pages Function verifies it server-side against the
# TURNSTILE_RESEARCH_SECRET Cloudflare secret (see wrangler.toml) before issuing a submission token.
#
# Both site keys are public (they ship in the client bundle), so like the form IDs they are supplied
# in CI as GitHub Actions *variables* of the same name (see deploy.yml), not secrets. An unset key ->
# that path posts without a token (Formspree only enforces when enabled; the research verifier is
# inert unless its secret is set).
# Placeholders only — set your own Turnstile site keys locally / in CI.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-forms-site-key
PUBLIC_TURNSTILE_RESEARCH_SITE_KEY=your-turnstile-research-site-key
