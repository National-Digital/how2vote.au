{
  "name": "@how2vote/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "og:generate": "node scripts/generate-og.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "precache:check": "node scripts/check-precache.mjs",
    "html-nesting:check": "node scripts/check-html-nesting.mjs",
    "prebuild:assets": "node scripts/generate-og.mjs && node scripts/generate-security-txt.mjs && node scripts/generate-error-pages.mjs && node scripts/generate-deep-link-assets.mjs && node ../../scripts/generate-store-badges.mjs && node ../../scripts/generate-app-version.mjs",
    "build": "pnpm prebuild:assets && vite build",
    "build:app": "git clean -fXq static && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "neutrality:check": "node scripts/neutrality-check.mjs"
  },
  "dependencies": {
    "@how2vote/data-schema": "workspace:*",
    "@how2vote/engine": "workspace:*",
    "altcha-lib": "^2.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^34.1.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "fast-check": "^4.9.0",
    "sharp": "^0.35.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "terser": "^5.49.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
