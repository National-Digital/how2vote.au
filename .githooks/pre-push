#!/bin/sh
# Pre-push: run the fast, no-extra-toolchain half of the CI gate before code leaves the machine, so a
# red PR is the exception. lint + typecheck + test + the source-only compliance guards (`preflight`)
# all run on plain Node/pnpm — no build, no browsers, no Ruby — and together cover the blocking checks
# that a normal (web) change can trip. `preflight` is ~13s; the whole hook is well under a minute.
#
# Deliberately NOT here (need heavy toolchains and/or are non-blocking safety/drift checks — catch
# them in CI, not on every contributor's push):
#   - `pnpm build` + the build-dependent gates (bundle budget, neutrality CSS scan) — minutes-slow.
#   - the Playwright e2e suites (flow, a11y, offline, electoral-output, research-native).
#   - the mobile store checks (fastlane/Ruby, Android/Xcode compiles) — these need Ruby/Java/Xcode,
#     are NOT merge-blocking, and only a change under apps/mobile/ (esp. the Gemfile) can affect them.
# See CONTRIBUTING.md → "Running checks locally" for the opt-in commands when you touch those areas.
#
# Skip in CI (which pushes nothing) and allow an explicit escape hatch for work-in-progress branches:
#   SKIP_HOOKS=1 git push
set -eu

[ "${CI:-}" = "true" ] && exit 0
[ "${SKIP_HOOKS:-}" = "1" ] && { echo "pre-push: skipped (SKIP_HOOKS=1)"; exit 0; }

echo "pre-push: pnpm lint (eslint + prettier --check)"
pnpm lint

echo "pre-push: pnpm typecheck"
pnpm typecheck

echo "pre-push: pnpm test"
pnpm test

echo "pre-push: pnpm preflight (source-only compliance guards)"
pnpm preflight

echo "pre-push: all local gates passed"
